# Consent Gate - environment
#
# Copy to .env, fill in, and source it. Nothing here is read from the repo;
# .env is gitignored.

# --- Foxit (stages 5 and 8) -------------------------------------------------
# Free developer account: https://app.developer-api.foxit.com/pricing
#   "Developer / Free / 500 shared credits per year"
#   includes eSign API, PDF Services API, Document Generation API
#   "NO CREDIT CARD REQUIRED"
FOXIT_CLIENT_ID=
FOXIT_CLIENT_SECRET=

# Optional. Defaults shown.
# FOXIT_HOST=https://na1.fusion.foxit.com
# FOXIT_ESIGN_HOST=            # defaults to FOXIT_HOST
# FOXIT_ESIGN_PREFIX=          # /esign/api/v1 by default, falls back to /api on 404

# --- SerpApi (stage 3, optional) --------------------------------------------
# Free tier: 250 searches/month. Absence is reported as UNVERIFIED_COUNTERPARTY,
# never silently skipped.
SERPAPI_API_KEY=

# --- Model backend ----------------------------------------------------------
# claude-code | anthropic | mock
CONSENT_GATE_BACKEND=claude-code

# Only for --backend anthropic. Not needed for claude-code or mock.
# ANTHROPIC_API_KEY=

# --- Workspace --------------------------------------------------------------
# CONSENT_GATE_WORKSPACE=workspace
# CONSENT_GATE_FIXTURES=fixtures
